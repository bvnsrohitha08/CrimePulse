# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database Connection String (Replace placeholder with your actual Atlas cluster URI)
# Preferred database name: crimepulse
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/crimepulse?retryWrites=true&w=majority

# FastAPI Microservice URL
ML_SERVICE_URL=http://127.0.0.1:8000

# Authentication JWT Configuration
JWT_SECRET=replace_with_secure_secret_string
JWT_EXPIRES_IN=1h
